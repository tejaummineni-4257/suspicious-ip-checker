# Copy these sections to Streamlit Community Cloud > App settings > Secrets.
# Replace every placeholder; never commit the real secrets.toml file.

# Optional AbuseIPDB key: public addresses checked with this key are disclosed
# to AbuseIPDB. Omit it to use only the local threat list.
ABUSEIPDB_API_KEY = ""

# Optional SMTP alert settings.
SMTP_HOST = ""
SMTP_PORT = "587"
SMTP_USERNAME = ""
SMTP_PASSWORD = ""
ALERT_FROM = ""
ALERT_TO = ""

[auth]
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_SECRET"
client_id = "YOUR_GOOGLE_OAUTH_CLIENT_ID"
client_secret = "YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[app]
environment = "production"
allowed_emails = ["your-google-email@example.com"]
