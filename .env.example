# Optional AbuseIPDB v2 API key. Never commit your real .env file.
ABUSEIPDB_API_KEY=

# Local development only. Set APP_ENV=production in Streamlit Cloud secrets.
APP_ENV=development

# Optional SMTP alert settings; use an app password when your provider requires one.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=
